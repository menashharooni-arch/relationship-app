# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# credentials runbook / any secrets inventory — NEVER commit (repo is public)
CREDENTIALS-RUNBOOK.md
*.secrets.md
secrets/

# vercel
.vercel

# claude code local settings (personal, per-machine)
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# Apple auth keys (.p8). These are private keys and download exactly once —
# they belong in ~/.swiftcard/keys, never in the repo.
*.p8
*.pem
AuthKey_*

# Generated by scripts/qa-sweep.mjs — screenshots and issues.json
qa-sweep-out/

# Scratch renders from scripts/appstore-explore.mjs (_explore) and
# scripts/office-ui-shots.mjs (_officeui*), plus a superseded raw set.
# We compare these locally; the shipped sets (_raw, 6.9-inch-v*) stay tracked.
app-store/screenshots/_explore/
app-store/screenshots/_officeui/
app-store/screenshots/_officeui_fixed/
app-store/screenshots/_raw-v2-old/

# Generated by scripts/qa-flows.mjs — screenshots and flow output
qa-flows-out/

# The rest of the QA output directories. qa-sweep-out and qa-flows-out were
# ignored; these four were not, so every a11y, office-links, mac or prod-probe
# run left untracked screenshots sitting in the tree — one broad `git add -A`
# from committing QA junk to the remote.
qa-a11y-out/
qa-office-links-out/
qa-mac-out/
qa-prod-probe-out/

# Pre-deletion account snapshots (scripts/delete-accounts.mjs). Real names,
# emails, phone numbers and captured leads — the restore path for an
# irreversible purge, and the last thing that should ever reach a git remote.
.account-backups/

# scripts/ios-release.sh --no-watch archives from a throwaway project copy
ios/App/App-NoWatch.xcodeproj/
