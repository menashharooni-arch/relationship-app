<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store distribution. Used by scripts/ios-release.sh. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>NHK8FA2RR2</string>
	<!-- MANUAL signing, deliberately. Automatic here means cloud signing
	     (Apple holds the key), which our App Manager API key is not allowed to
	     do — export dies with "Cloud signing permission error". Instead,
	     scripts/asc-provision.mjs mints a classic Apple Distribution
	     certificate (private key in ~/.swiftcard/dist) and App Store profiles
	     through the ASC API, and this maps each bundle id to its profile.
	     App Store profiles need no registered devices. -->
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>me.swiftcard.app</key>
		<string>SwiftCard App Store</string>
		<key>me.swiftcard.app.SwiftCardWidgetExtension</key>
		<string>SwiftCard Widget App Store</string>
	</dict>
	<!-- dSYMs, so native crashes can be symbolicated. -->
	<key>uploadSymbols</key>
	<true/>
	<key>stripSwiftSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
